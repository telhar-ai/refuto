    {
      "id": "adversarial-reviewer",
      "group": "security",
      "phase": "VALIDATE",
      "purpose": "Revisa intentando refutar, no confirmar. No propone soluciones.",
      "input_contract": [
        "code",
        "architecture",
        "test-report"
      ],
      "output_contract": [
        "findings"
      ],
      "required_capabilities": [
        "agent.headless"
      ],
      "allowed_tools": [
        "read",
        "grep",
        "glob"
      ],
      "constraints": [
        "no_write_code",
        "no_shell",
        "no_fix_what_it_reviews"
      ],
      "quality_gates": [],
      "human_review": "",
      "handoff": [
        "reviewer"
      ],
      "notes": "Un revisor que arregla lo que critica deja de criticar con dureza, porque arreglar es más cómodo que derribar."
    },
    {
      "id": "reviewer",
      "group": "quality",
      "phase": "VALIDATE",
      "purpose": "Consolida el estado de las puertas y decide si el cambio es integrable.",
      "input_contract": [
        "test-report",
        "security-report",
        "findings",
        "visual-report"
      ],
      "output_contract": [
        "review-report"
      ],
      "required_capabilities": [
        "agent.headless"
      ],
      "allowed_tools": [
        "read",
        "grep"
      ],
      "constraints": [
        "no_write_code",
        "no_self_approval"
      ],
      "quality_gates": [
        "G-PR",
        "G-HUMAN"
      ],
      "human_review": "HUMAN_PR_REVIEW",
      "handoff": [
        "release-engineer"
      ],
      "notes": "No puede revisar un cambio que produjo el mismo agente. Lo comprueba G-HUMAN, que exige que quien aprueba no sea quien genero; no depende de la buena voluntad. Ojo: es una puerta, no el guardian, asi que actua al verificar, no al escribir."
    },
    {
      "id": "release-engineer",
      "group": "devops",
      "phase": "RELEASE",
      "purpose": "Empaqueta, firma y publica; verifica que lo desplegado es lo que se aprobó.",
