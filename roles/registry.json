      "quality_gates": [
        "G-POLICY"
      ],
      "human_review": "",
      "handoff": [
        "security-engineer"
      ],
      "notes": "Lo regulatorio y lo de seguridad entra al diseño, no a la revisión final."
    },
    {
      "id": "data-architect",
      "group": "architecture",
      "phase": "ARCHITECT",
      "purpose": "Define contratos de datos, linaje y clasificación.",
      "input_contract": [
        "architecture"
      ],
      "output_contract": [
        "data-contracts"
      ],
      "required_capabilities": [
        "agent.headless"
      ],
      "allowed_tools": [
        "read",
