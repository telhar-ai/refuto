      "handoff": [
        "test-engineer"
      ],
      "notes": ""
    },
    {
      "id": "test-engineer",
      "group": "quality",
      "phase": "TEST",
      "purpose": "Escribe y ejecuta pruebas que citan el requisito que comprueban.",
      "input_contract": [
        "code",
        "test-strategy"
      ],
      "output_contract": [
        "tests",
        "coverage",
        "test-report"
      ],
      "required_capabilities": [
        "agent.headless",
        "agent.tool_use"
      ],
      "allowed_tools": [
        "read",
        "write",
