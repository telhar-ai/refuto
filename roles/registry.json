{
  "schema": "harness.roles/v1",
  "_que_es": "Taxonomia de roles de ingenieria. Un ROL es una unidad de trabajo con contrato; un AGENTE es un runtime que puede ejecutarlo. El router empareja los dos por capacidad, nunca por nombre. Anadir un rol es anadir un objeto aqui.",
  "version": "1",
  "roles": [
    {
      "id": "product-strategist",
      "group": "management",
      "phase": "DISCOVER",
      "purpose": "Convierte una intención de negocio en un problema acotado, con el descarte razonado.",
      "input_contract": [
        "intent"
      ],
      "output_contract": [
        "problem-statement",
        "success-criteria"
      ],
      "required_capabilities": [
        "agent.headless"
      ],
      "allowed_tools": [
        "read",
        "grep",
        "glob"
      ],
      "constraints": [
        "no_write_code",
        "no_shell"
      ],
      "quality_gates": [],
      "human_review": "",
      "handoff": [
        "requirements-engineer"
      ],
      "notes": "No escribe requisitos: acota el problema. Mezclar las dos cosas produce requisitos que justifican una solución ya elegida."
    },
    {
      "id": "delivery-manager",
      "group": "management",
      "phase": "PLAN",
      "purpose": "Ordena el trabajo en un plan con dependencias, riesgos y puntos de decisión humana.",
      "input_contract": [
        "specification",
        "architecture"
      ],
      "output_contract": [
        "plan",
        "risk-register"
      ],
      "required_capabilities": [
        "agent.headless"
      ],
      "allowed_tools": [
        "read",
        "grep",
        "glob"
      ],
      "constraints": [
        "no_write_code",
        "no_shell"
      ],
      "quality_gates": [
        "G-TRACE"
      ],
      "human_review": "",
      "handoff": [
        "backend-engineer",
        "frontend-engineer"
      ],
      "notes": ""
    },
    {
      "id": "requirements-engineer",
      "group": "specification",
      "phase": "SPECIFY",
      "purpose": "Escribe requisitos verificables en EARS, cada uno con su criterio de aceptación.",
      "input_contract": [
        "problem-statement",
        "user-stories"
      ],
      "output_contract": [
        "requirements"
      ],
      "required_capabilities": [
        "agent.headless"
      ],
      "allowed_tools": [
        "read",
        "write",
        "grep",
        "glob"
      ],
      "constraints": [
        "no_shell",
        "no_write_code"
      ],
      "quality_gates": [
        "G-TRACE",
        "G-SDD"
      ],
      "human_review": "HUMAN_APPROVAL",
      "handoff": [
        "solution-architect"
      ],
      "notes": "Sin consola a propósito: esta fase no ejecuta nada, y dársela sería regalar superficie a cambio de nada."
    },
    {
      "id": "acceptance-engineer",
      "group": "specification",
      "phase": "SPECIFY",
      "purpose": "Deriva criterios de aceptación ejecutables de cada requisito.",
      "input_contract": [
        "requirements"
      ],
      "output_contract": [
        "acceptance-criteria"
      ],
      "required_capabilities": [
        "agent.headless"
      ],
      "allowed_tools": [
        "read",
        "write",
        "grep"
      ],
      "constraints": [
        "no_shell",
        "no_write_code"
      ],
      "quality_gates": [
        "G-TRACE"
      ],
      "human_review": "",
      "handoff": [
        "test-strategist"
      ],
      "notes": ""
    },
    {
      "id": "solution-architect",
      "group": "architecture",
      "phase": "ARCHITECT",
      "purpose": "Decide la estructura, con al menos una alternativa descartada y su condición de reversión.",
      "input_contract": [
        "requirements"
      ],
      "output_contract": [
        "architecture",
        "adr"
      ],
      "required_capabilities": [
        "agent.headless"
      ],
      "allowed_tools": [
        "read",
        "write",
        "grep",
        "glob"
      ],
      "constraints": [
        "no_write_code"
      ],
      "quality_gates": [
        "G-SDD"
      ],
      "human_review": "HUMAN_APPROVAL",
      "handoff": [
        "backend-engineer",
        "frontend-engineer",
        "security-architect"
      ],
      "notes": "Una decisión sin descarte razonado es una preferencia."
    },
    {
      "id": "security-architect",
      "group": "architecture",
      "phase": "ARCHITECT",
      "purpose": "Modela amenazas y superficie de ataque antes de que exista el código.",
      "input_contract": [
        "architecture"
      ],
      "output_contract": [
        "threat-model",
        "security-requirements"
      ],
      "required_capabilities": [
        "agent.headless"
