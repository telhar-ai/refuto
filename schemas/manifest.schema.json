{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:refuto:schema:manifest:v1",
  "title": "Manifiesto de refuto",
  "description": "Lo que este espacio de trabajo declara necesitar para operar agentes. Es la mitad del contrato; la otra mitad es harness.lock.json, que dice con qué se materializó. Se escribe a mano; el lock no.",
  "type": "object",
  "required": [
    "schema",
    "harness",
    "agents",
    "gates"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "harness.manifest/v1"
    },
    "harness": {
      "type": "object",
      "required": [
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+"
        },
        "min_python": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+$"
        }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "profile": {
          "enum": [
            "minimal",
            "standard",
            "governed"
          ]
        },
        "containers": {
          "type": "array",
          "description": "Directorios OCULTOS que contienen repositorios en vez de artefactos (por omision `.worktrees`). Se recorren; el resto de lo oculto no.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "agents": {
      "type": "object",
      "description": "Agentes que este espacio usa. `required: true` significa que una corrida sin él NO es válida — y G-AGENT lo exige llegando a FUNCTIONAL, no a 'está en el PATH'.",
      "minProperties": 0,
      "patternProperties": {
        "^[a-z][a-z0-9-]*$": {
          "$ref": "#/$defs/agentEntry"
        }
      },
      "additionalProperties": false
    },
    "gates": {
      "type": "array",
      "description": "Puertas que se ejecutan. Una puerta implementada y no declarada NO corre, y G-MANIFEST lo dice.",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9-]+$"
      }
    },
    "sources": {
      "type": "object",
      "description": "Orígenes que se materializan en este espacio. El ancla real vive en el lock: aquí sólo se declara qué se quiere.",
      "patternProperties": {
        "^[a-z][a-z0-9-]*$": {
          "$ref": "#/$defs/sourceEntry"
        }
      },
      "additionalProperties": false
    },
    "skills": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "roots": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "require_name_matches_directory": {
          "type": "boolean"
        }
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required_servers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "protocol_version": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "artifacts": {
      "type": "array",
      "description": "Archivos que deben existir para que el espacio se considere completo.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "compile_to": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "provider": {
      "type": "object",
      "description": "A que proveedor debe hablar el agente en este espacio. Declararlo una vez evita que una variable de entorno heredada del shell redirija las sesiones sin que nadie se entere.",
      "additionalProperties": false,
      "required": [
        "expect"
      ],
      "properties": {
        "expect": {
          "enum": [
            "subscription",
            "api-key",
            "bedrock",
            "vertex",
            "foundry",
            "custom"
          ]
        }
      }
    },
    "anchoring": {
      "type": "object",
      "description": "Ancla certificada del diario (core/concordia.py, ADR-0017). `membership_digest` es el PIN: el digest de la membresía de concordia en la que se confia, fijado por una persona fuera de banda. Refuto NUNCA lo deduce de lo que sirva el cluster. Sin esta seccion no se ancla; con ella y sin pin valido, verify/status quedan BLOCKED.",
      "additionalProperties": false,
      "required": [
        "provider",
        "endpoints",
        "membership_digest"
      ],
      "properties": {
        "provider": {
          "const": "concordia"
        },
        "endpoints": {
          "type": "array",
          "minItems": 1,
          "description": "Replicas de concordia. SOLO LOCAL hasta la publicacion (decision de la persona, 2026-09-27): unicamente 127.0.0.1, localhost o [::1]. core/concordia.py lo vuelve a comprobar en tiempo de ejecucion antes de abrir ninguna conexion.",
          "items": {
            "type": "string",
            "pattern": "^https?://(127\\.0\\.0\\.1|localhost|\\[::1\\])(:[0-9]{1,5})?(/.*)?$"
          }
        },
        "membership_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "network_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "membership_version": {
          "type": "integer",
          "minimum": 0
        },
        "timeout_s": {
          "type": "number",
          "minimum": 0.1
        },
        "pinned_by": {
          "type": "string",
          "minLength": 1
        },
        "pinned_at": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "classification": {
      "type": "object",
      "description": "Vocabulario propio del proyecto para clasificar historias. Las claves son los valores que el equipo escribe en el campo Tipo de cada historia.",
      "additionalProperties": false,
      "properties": {
        "aliases": {
          "type": "object",
          "patternProperties": {
            "^[A-Za-z][A-Za-z0-9_-]*$": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        }
      }
    },
    "specs": {
      "type": "object",
      "description": "Donde viven las especificaciones en ESTE espacio. Sin esto se usan las tres convenciones conocidas (kiro, flat, sdd). `globs` manda sobre `profiles`; cada patron apunta al documento de requisitos.",
      "additionalProperties": false,
      "properties": {
        "profiles": {
          "type": "array",
          "items": {
            "enum": [
              "kiro",
              "flat",
              "sdd"
            ]
          }
        },
        "globs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "integrations": {
      "type": "object",
      "description": "Verificadores EXTERNOS que este espacio declara. Sin declaracion, G-SDD sale NOT_APPLICABLE y no se ejecuta nada: un programa que aparece en el arbol no es un programa que el espacio haya autorizado a correr.",
      "additionalProperties": false,
      "properties": {
        "spec_core": {
          "$ref": "#/$defs/externalVerifier"
        },
        "sdd_core": {
          "$ref": "#/$defs/externalVerifier"
        }
      }
    },
    "knowledge": {
      "type": "object",
      "description": "De donde sale lo que el espacio DECLARA de si mismo. Se distingue de lo medido: dice lo que el proyecto cree, que no es lo que hay.",
      "additionalProperties": false,
      "properties": {
        "capability_register": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "agentEntry": {
      "type": "object",
      "required": [
        "required"
      ],
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "boolean"
        },
        "min_version": {
          "type": "string"
        },
        "min_level": {
          "enum": [
            "INSTALLED",
            "STARTABLE",
            "FUNCTIONAL",
            "VERIFIED"
          ]
        },
        "note": {
          "type": "string"
        },
        "unguarded": {
          "type": "boolean",
          "description": "Se acepta abrir sesion con este runtime SIN guardian preventivo, porque refuto no sabe enganchar uno aqui. Declararlo no lo arregla: lo hace visible, y se avisa en cada arranque."
        }
      }
    },
    "sourceEntry": {
      "type": "object",
      "required": [
        "uri",
        "ref"
      ],
      "additionalProperties": false,
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "materialize": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from",
              "to"
            ],
            "additionalProperties": false,
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "externalVerifier": {
      "type": "object",
      "description": "Puente a un verificador que este espacio ya tenia. Su veredicto se traduce, no se reinterpreta.",
      "required": [
        "runner",
        "report"
      ],
      "additionalProperties": false,
      "properties": {
        "runner": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "report": {
          "type": "string",
          "minLength": 1
        },
        "gates_key": {
          "type": "string",
          "minLength": 1
        },
        "status_map": {
          "type": "object"
        }
      }
    }
  }
}
