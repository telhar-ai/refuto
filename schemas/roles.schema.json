{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:refuto:schema:roles:v1",
  "title": "Taxonomía de roles de ingeniería",
  "type": "object",
  "required": ["schema", "version", "roles"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "harness.roles/v1" },
    "version": { "type": "string", "minLength": 1 },
    "roles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/role" } }
  },
  "$defs": {
    "role": {
      "type": "object",
      "required": ["id", "group", "phase", "purpose", "output_contract",
                   "required_capabilities", "allowed_tools", "constraints"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "group": { "enum": ["management", "specification", "architecture", "ux",
                            "development", "quality", "security", "devops",
                            "infrastructure", "documentation"] },
        "phase": { "type": "string", "pattern": "^[A-Z]+$" },
        "purpose": { "type": "string", "minLength": 20 },
        "input_contract": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "output_contract": { "type": "array", "minItems": 1,
                             "items": { "type": "string", "minLength": 1 } },
        "required_capabilities": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "allowed_tools": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "constraints": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "quality_gates": { "type": "array", "items": { "type": "string", "pattern": "^G-[A-Z]+$" } },
        "human_review": { "enum": ["", "HUMAN_APPROVAL", "HUMAN_VISUAL_REVIEW",
                                   "HUMAN_PR_REVIEW", "HUMAN_SECURITY_REVIEW",
                                   "HUMAN_RELEASE_APPROVAL"] },
        "handoff": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" } },
        "notes": { "type": "string" }
      }
    }
  }
}
